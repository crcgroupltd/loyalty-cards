# Copy to .env (local dev) or set these in docker-compose.yml.

# The public URL people open, exactly as the browser shows it (no trailing slash).
# Passkeys are bound to this domain; mutating requests must come from it.
ORIGIN=https://cards.example.com

# Optional: passkey "relying party" ID. Defaults to ORIGIN's hostname.
# RP_ID=cards.example.com

# One-time token for creating the first admin. If unset, a random token is
# printed to the logs at startup until the first admin exists.
SETUP_TOKEN=

# Who to trust for X-Forwarded-For/Proto: "true", a hop count, or the reverse
# proxy's IP/CIDR (e.g. 172.18.0.0/16 for a Docker network). Needed for
# per-client rate limiting behind a proxy.
TRUST_PROXY=1

# Optional: logo.dev SECRET key (sk_...) to enable logo search by store name.
# The store name is sent to logo.dev; nothing else is.
LOGO_API_KEY=

# Where the SQLite database and logos live.
DATA_DIR=./data

PORT=3000
